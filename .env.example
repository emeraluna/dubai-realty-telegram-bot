TELEGRAM_BOT_TOKEN=
APIFY_TOKEN=
SCRAPEFORGE_KEY=
# Portable copy: use SQLite (setup.ps1 writes absolute paths). Docker/Postgres: use asyncpg URL below.
DATABASE_URL=sqlite+aiosqlite:///./data/realty.db
# DATABASE_URL=postgresql+asyncpg://realty:realty@localhost:5432/realty
LOG_LEVEL=INFO
ALLOWED_TELEGRAM_IDS=
IMPORT_ADMIN_IDS=
IMPORT_FUZZY_THRESHOLD=85
DLD_OWNER_ENRICHMENT=true
DLD_TRY_AD_LICENSE=true
DLD_AD_LICENSE_MIN_LENGTH=5
DLD_AD_LICENSE_MAX_LENGTH=15
OWNER_RESOLVE_ENABLED=true
OWNER_RESOLVE_TIMEOUT_HOURS=5
OWNER_RESOLVE_POLL_SECONDS=300
CACHE_TTL_DAYS=30
TRAKHEESI_PERMIT_MIN_LENGTH=10
